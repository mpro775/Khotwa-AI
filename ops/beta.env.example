# Reviewed Beta setup example. No secret values; never use an owner DB URL in API.
BETA_HOST=beta.example.com
BETA_DB_OWNER_PASSWORD=
BETA_DB_APP_PASSWORD=
BETA_DB_BACKUP_PASSWORD=
BACKUP_ENCRYPTION_KEY=
BACKUP_MAX_FILES=7
ACCOUNTS_ENABLED=true
ACCOUNT_OTP_DIGEST_KEY=
ACCOUNT_OTP_TTL_SECONDS=600
ACCOUNT_SESSION_TTL_SECONDS=604800
ACCOUNT_GLOBAL_OTP_PER_HOUR=200
ACCOUNT_ADMIN_ALLOWLIST=
ACCOUNT_CONTENT_MANAGER_ALLOWLIST=
ACCOUNT_INTERNAL_ALLOWLIST=
ACCOUNT_MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_IMPLICIT_TLS=true
BETA_ENABLED=true
BETA_ACCESS_PAUSED=true
BETA_EMAIL_ALLOWLIST=
BETA_AI_ENABLED=false
BETA_AI_DAILY_COST_MICROS=0
BETA_AI_MONTHLY_COST_MICROS=0
BETA_AI_USER_DAILY_CALLS=10
BETA_AI_USER_DAILY_TOKENS=64000
BETA_AI_MAX_CALL_COST_MICROS=0
# Operator-maintained USD micro-unit rates per million provider-reported tokens.
# Missing model/price/usage stays UNKNOWN, never zero spending.
GEMINI_PRICING_JSON=
REAL_LEARNING_ENABLED=false
REAL_LEARNING_POLICY_VERSION=real-learning-v1
REAL_LEARNING_APPROVAL_REFERENCE=
AI_ENABLED=false
GEMINI_API_KEY=
BETA_GEMINI_ENABLED=false
BETA_GEMINI_AUTHORIZATION_ID=
BETA_GEMINI_AUTHORIZATION_EXPIRES_AT=
BETA_GEMINI_MODEL=
BETA_GEMINI_THINKING_LEVEL=minimal
BETA_GEMINI_KNOWN_DAILY_REMAINING=
BETA_GEMINI_DAILY_REQUEST_LIMIT=20
BETA_GEMINI_RPM=5
BETA_GEMINI_MAX_PARALLEL=1
BETA_GEMINI_TIMEOUT_MS=8000
# Requires reviewed provider semantics: maxOutputTokens includes thinking.
BETA_GEMINI_OUTPUT_CAP_POLICY=
BETA_GEMINI_MAX_BILLABLE_OUTPUT_TOKENS=256
PROGRAMMING_CASES_PER_MINUTE=200
PROGRAMMING_CASES_PER_DAY=2000
RUNNER_OWNER_CONCURRENCY=1
RUNNER_GLOBAL_CONCURRENCY=4
RETENTION_DATABASE_URL=
# Migration/test account policies remain provisional until real-user privacy review.
# Existing PH04…PH09 flags/limits and distinct security keys must also be configured.
