# Reviewed Beta setup example. No secret values; never use an owner DB URL in API.
BETA_HOST=beta.example.com
BETA_DB_OWNER_PASSWORD=
BETA_DB_APP_PASSWORD=
BETA_DB_BACKUP_PASSWORD=
BACKUP_ENCRYPTION_KEY=
BACKUP_MAX_FILES=7
ACCOUNTS_ENABLED=true
ACCOUNT_OTP_DIGEST_KEY=
ACCOUNT_OTP_TTL_SECONDS=600
ACCOUNT_SESSION_TTL_SECONDS=604800
ACCOUNT_GLOBAL_OTP_PER_HOUR=200
ACCOUNT_ADMIN_ALLOWLIST=
ACCOUNT_CONTENT_MANAGER_ALLOWLIST=
ACCOUNT_INTERNAL_ALLOWLIST=
ACCOUNT_MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_IMPLICIT_TLS=true
BETA_ENABLED=true
BETA_ACCESS_PAUSED=true
BETA_EMAIL_ALLOWLIST=
BETA_AI_ENABLED=false
BETA_AI_DAILY_COST_MICROS=0
BETA_AI_MONTHLY_COST_MICROS=0
BETA_AI_USER_DAILY_CALLS=10
BETA_AI_USER_DAILY_TOKENS=10000
BETA_AI_MAX_CALL_COST_MICROS=0
RETENTION_DATABASE_URL=
# Migration/test account policies remain provisional until real-user privacy review.
# Existing PH04…PH09 flags/limits and distinct security keys must also be configured.
