{
  "components": {
    "schemas": {
      "Assignment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "episodeId": { "type": "string", "format": "uuid" },
          "phase": {
            "type": "string",
            "enum": ["probe", "remediation", "transfer"]
          },
          "problemRevisionId": { "type": "string", "format": "uuid" },
          "problem": { "$ref": "#/components/schemas/ProblemDetail" },
          "assistancePolicy": {
            "type": "string",
            "enum": ["guided", "limited", "independent"]
          },
          "attemptId": {
            "anyOf": [
              { "type": "string", "format": "uuid" },
              { "type": "null" }
            ]
          },
          "assignedAt": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "episodeId",
          "phase",
          "problemRevisionId",
          "problem",
          "assistancePolicy",
          "attemptId",
          "assignedAt"
        ]
      },
      "Attempt": {
        "type": "object",
        "additionalProperties": false,
        "description": "مصدر الحقيقة للحالة الحالية؛ النتائج السابقة تبقى تاريخية ولا تُعد نتائج نشطة بعد التعديل.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "learningSessionId": { "type": "string", "format": "uuid" },
          "problemRevisionId": { "type": "string", "format": "uuid" },
          "kind": { "$ref": "#/components/schemas/AttemptKind" },
          "revision": {
            "type": "integer",
            "format": "int32",
            "description": "إصدار محاولة، يعادل bigint في PostgreSQL لكنه مقيد هنا إلى Int32 آمن لواجهات JavaScript.",
            "minimum": 0,
            "maximum": 2147483647,
            "example": 4
          },
          "status": { "$ref": "#/components/schemas/AttemptStatus" },
          "completionVerdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["verified_complete", "not_complete", "unknown"]
              },
              { "type": "null" }
            ]
          },
          "notationProfile": { "type": "string" },
          "steps": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Step" }
          },
          "openedAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "parentEpisodeId": {
            "anyOf": [
              { "type": "string", "format": "uuid" },
              { "type": "null" }
            ]
          },
          "currentVerification": {
            "anyOf": [
              { "$ref": "#/components/schemas/VerificationReport" },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "id",
          "learningSessionId",
          "problemRevisionId",
          "kind",
          "revision",
          "status",
          "completionVerdict",
          "notationProfile",
          "steps",
          "openedAt",
          "updatedAt",
          "parentEpisodeId",
          "currentVerification"
        ]
      },
      "AttemptEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/Attempt" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["data", "meta"]
      },
      "AttemptKind": {
        "type": "string",
        "enum": ["main", "probe", "remediation", "transfer"]
      },
      "AttemptListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/ListAttempts" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["data", "meta"]
      },
      "AttemptStatus": {
        "type": "string",
        "enum": ["in_progress", "completed", "assisted_completed", "stopped"]
      },
      "BootstrapData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "csrfToken": {
            "type": "string",
            "description": "رمز حماية ضد تزوير الطلبات، ليس رمز جلسة دخول.",
            "minLength": 32
          },
          "csrfHeaderName": { "type": "string", "enum": ["X-CSRF-Token"] },
          "capabilities": { "$ref": "#/components/schemas/Capabilities" },
          "hasActiveGuestSession": { "type": "boolean" }
        },
        "required": [
          "csrfToken",
          "csrfHeaderName",
          "capabilities",
          "hasActiveGuestSession"
        ]
      },
      "BootstrapEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/BootstrapData" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["data", "meta"]
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "notationProfile": {
            "type": "string",
            "enum": ["ar-mashriq-school-v1"]
          },
          "subject": { "type": "string", "enum": ["algebra"] },
          "variable": { "type": "string", "enum": ["س"] },
          "mathModes": {
            "type": "array",
            "items": { "type": "string", "enum": ["linear_one_variable"] }
          },
          "supportsTrigonometry": { "type": "boolean", "default": false },
          "supportsHandwriting": { "type": "boolean", "default": false },
          "supportsFractions": {
            "type": "boolean",
            "description": "تفعيل الكسور يخضع لنجاح اختبارات العرض.",
            "default": false
          },
          "supportsTeacherRealData": { "type": "boolean", "default": false },
          "supportedMathStatuses": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MathStatus" }
          }
        },
        "required": [
          "notationProfile",
          "subject",
          "variable",
          "mathModes",
          "supportsTrigonometry",
          "supportsHandwriting",
          "supportsFractions",
          "supportsTeacherRealData",
          "supportedMathStatuses"
        ]
      },
      "Completion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "enum": ["not_complete", "verified_complete", "unknown"]
          },
          "canMarkAttemptCompleted": { "type": "boolean" },
          "explanationAr": { "type": "string" }
        },
        "required": ["state", "canMarkAttemptCompleted", "explanationAr"]
      },
      "Counterexample": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "variable": { "type": "string", "enum": ["س"] },
          "value": { "$ref": "#/components/schemas/Rational" },
          "satisfiesPrevious": { "type": "boolean" },
          "satisfiesNext": { "type": "boolean" }
        },
        "required": ["variable", "value", "satisfiesPrevious", "satisfiesNext"]
      },
      "DiagnosisCandidate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "diagnosisId": {
            "anyOf": [
              { "type": "string", "format": "uuid" },
              { "type": "null" }
            ]
          },
          "state": { "$ref": "#/components/schemas/DiagnosisState" },
          "errorCode": {
            "anyOf": [
              {
                "type": "string",
                "description": "كود خطأ من ERR-ALG-01 إلى ERR-ALG-06.",
                "pattern": "^ERR-ALG-0[1-6]$"
              },
              { "type": "null" }
            ]
          },
          "skillId": {
            "anyOf": [
              { "type": "string", "format": "uuid" },
              { "type": "null" }
            ]
          },
          "explanationAr": {
            "type": "string",
            "description": "صياغة احتمالية، لا حكم قطعي."
          },
          "needsProbe": { "type": "boolean" }
        },
        "required": [
          "diagnosisId",
          "state",
          "errorCode",
          "skillId",
          "explanationAr",
          "needsProbe"
        ]
      },
      "DiagnosisState": {
        "type": "string",
        "description": "حالة فرضية الخطأ، وليست حكمًا على الطالب.",
        "enum": [
          "tentative",
          "needs_probe",
          "supported_by_probe",
          "rejected",
          "unresolved"
        ]
      },
      "EpisodeEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/LearningEpisode" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["data", "meta"]
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "description": "رمز خطأ تطبيقي ثابت للمستهلك.",
            "enum": [
              "invalid_input",
              "unauthenticated",
              "forbidden",
              "not_found",
              "session_expired",
              "revision_conflict",
              "idempotency_conflict",
              "stale_decision",
              "no_safe_activity",
              "request_in_progress",
              "invalid_state",
              "content_version_conflict",
              "math_unsupported",
              "math_inconclusive",
              "math_unavailable",
              "ai_unavailable",
              "rate_limited",
              "internal_error",
              "csrf_invalid"
            ]
          },
          "messageAr": { "type": "string" },
          "issues": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ValidationIssue" }
          },
          "currentRevision": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "آخر إصدار عند تعارض تعديل.",
                "minimum": 0,
                "maximum": 2147483647,
                "example": 4
              },
              { "type": "null" }
            ]
          },
          "retryable": { "type": "boolean" },
          "retryAfterSeconds": {
            "anyOf": [
              { "type": "integer", "format": "int32", "minimum": 0 },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "code",
          "messageAr",
          "issues",
          "currentRevision",
          "retryable",
          "retryAfterSeconds"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorDetail" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["error", "meta"]
      },
      "GuestCreateData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session": { "$ref": "#/components/schemas/GuestSession" },
          "csrfToken": {
            "type": "string",
            "description": "رمز حماية جديد إن تم تدويره بعد إصدار الجلسة؛ يستبدل الرمز السابق.",
            "minLength": 32
          }
        },
        "required": ["session", "csrfToken"]
      },
      "GuestCurrentEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/GuestSession" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["data", "meta"]
      },
      "GuestEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/GuestCreateData" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["data", "meta"]
      },
      "GuestSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["active", "expired", "revoked"]
          },
          "expiresAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "status", "expiresAt", "createdAt"]
      },
      "HintEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/TutoringEvent" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["data", "meta"]
      },
      "HintLevel": {
        "type": "string",
        "description": "المساعدة من دون تلميح إلى الحل الكامل.",
        "enum": ["H0", "H1", "H2", "H3", "H4"]
      },
      "LearningEpisode": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "rootAttemptId": { "type": "string", "format": "uuid" },
          "skillId": { "type": "string", "format": "uuid" },
          "state": { "$ref": "#/components/schemas/LearningEpisodeState" },
          "assignments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Assignment" }
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "endedAt": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "nextAction": {
            "type": "string",
            "enum": [
              "answer_probe",
              "start_remediation",
              "complete_remediation",
              "start_transfer",
              "review_progress",
              "none"
            ]
          }
        },
        "required": [
          "id",
          "rootAttemptId",
          "skillId",
          "state",
          "assignments",
          "createdAt",
          "endedAt",
          "nextAction"
        ]
      },
      "LearningEpisodeState": {
        "type": "string",
        "enum": [
          "proposed",
          "probing",
          "remediating",
          "awaiting_transfer",
          "finished",
          "cancelled"
        ]
      },
      "LearningSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["active", "ended", "abandoned"]
          },
          "releaseId": { "type": "string", "format": "uuid" },
          "startedAt": { "type": "string", "format": "date-time" },
          "endedAt": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "isSynthetic": {
            "type": "boolean",
            "description": "تكون false دائمًا في جلسات الطلاب الحقيقيين."
          }
        },
        "required": [
          "id",
          "status",
          "releaseId",
          "startedAt",
          "endedAt",
          "isSynthetic"
        ]
      },
      "LearningSessionEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/LearningSession" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["data", "meta"]
      },
      "ListAttempts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Attempt" }
          },
          "nextCursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "required": ["items", "nextCursor"]
      },
      "ListProblems": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProblemSummary" }
          },
          "nextCursor": {
            "anyOf": [
              { "type": "string", "description": "مؤشر معتم لا تُفسر قيمته." },
              { "type": "null" }
            ]
          }
        },
        "required": ["items", "nextCursor"]
      },
      "ListSkills": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Skill" }
          }
        },
        "required": ["items"]
      },
      "MathEvidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["counterexample", "solution_set", "rule_violation", "none"]
          },
          "domain": { "type": "string", "enum": ["reals"] },
          "previousSolution": {
            "anyOf": [
              { "$ref": "#/components/schemas/SolutionSet" },
              { "type": "null" }
            ]
          },
          "nextSolution": {
            "anyOf": [
              { "$ref": "#/components/schemas/SolutionSet" },
              { "type": "null" }
            ]
          },
          "witness": {
            "anyOf": [
              { "$ref": "#/components/schemas/Counterexample" },
              { "type": "null" }
            ]
          },
          "summaryAr": {
            "anyOf": [
              {
                "type": "string",
                "description": "شرح الدليل بعد التحقق الرياضي، وليس توليدًا غير موثق."
              },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "kind",
          "domain",
          "previousSolution",
          "nextSolution",
          "witness",
          "summaryAr"
        ]
      },
      "MathIssue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reasonCode": {
            "type": "string",
            "description": "رمز ثابت مثل AMBIGUOUS_DIVISION.",
            "maxLength": 80
          },
          "messageAr": {
            "type": "string",
            "description": "رسالة عربية قابلة للعرض دون traceback."
          },
          "spanStart": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "موضع البداية بوحدات Unicode code points.",
                "minimum": 0
              },
              { "type": "null" }
            ]
          },
          "spanEnd": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "نهاية المدى حصريًا.",
                "minimum": 0
              },
              { "type": "null" }
            ]
          },
          "spanUnit": { "type": "string", "enum": ["unicode_codepoint"] },
          "hintKey": {
            "anyOf": [
              {
                "type": "string",
                "description": "مفتاح رسالة توجيهية.",
                "maxLength": 80
              },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "reasonCode",
          "messageAr",
          "spanStart",
          "spanEnd",
          "spanUnit",
          "hintKey"
        ]
      },
      "MathSource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceRaw": {
            "type": "string",
            "description": "الصيغة العربية كما أدخلها الطالب دون استبدال صامت.",
            "maxLength": 256,
            "example": "٢س + ٦ = ١٠"
          },
          "displayAr": {
            "anyOf": [
              {
                "type": "string",
                "description": "العرض العربي الذي صادق عليه المحرك بعد التحليل."
              },
              { "type": "null" }
            ]
          },
          "parseStatus": {
            "type": "string",
            "description": "حالة التحليل البنيوي.",
            "enum": [
              "not_checked",
              "parsed",
              "syntax_error",
              "unsupported",
              "inconclusive"
            ]
          }
        },
        "required": ["sourceRaw", "displayAr", "parseStatus"]
      },
      "MathStatus": {
        "type": "string",
        "description": "حكم محرك الرياضيات؛ لا يساوي تشخيصًا تربويًا.",
        "enum": [
          "verified_valid",
          "verified_invalid",
          "syntax_error",
          "unsupported",
          "inconclusive",
          "service_error"
        ]
      },
      "Meta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "description": "معرّف تتبع الطلب.",
            "format": "uuid"
          },
          "serverTime": {
            "type": "string",
            "description": "وقت الاستجابة UTC.",
            "format": "date-time"
          },
          "apiVersion": {
            "type": "string",
            "description": "إصدار الواجهة.",
            "example": "1"
          }
        },
        "required": ["requestId", "serverTime", "apiVersion"]
      },
      "Probe": {
        "type": "object",
        "additionalProperties": false,
        "description": "لا تُرسل الإجابة الصحيحة إلى الطالب قبل إرسال الإجابة.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "attemptId": { "type": "string", "format": "uuid" },
          "attemptRevision": {
            "type": "integer",
            "format": "int32",
            "description": "إصدار محاولة، يعادل bigint في PostgreSQL لكنه مقيد هنا إلى Int32 آمن لواجهات JavaScript.",
            "minimum": 0,
            "maximum": 2147483647,
            "example": 4
          },
          "diagnosisId": {
            "anyOf": [
              { "type": "string", "format": "uuid" },
              { "type": "null" }
            ]
          },
          "questionAr": { "type": "string" },
          "responseMode": { "type": "string", "enum": ["choice", "text"] },
          "options": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProbeOption" }
          },
          "status": {
            "type": "string",
            "enum": ["open", "answered", "cancelled"]
          }
        },
        "required": [
          "id",
          "attemptId",
          "attemptRevision",
          "diagnosisId",
          "questionAr",
          "responseMode",
          "options",
          "status"
        ]
      },
      "ProbeAnswerEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/ProbeEvaluation" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["data", "meta"]
      },
      "ProbeEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/Probe" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "required": ["data", "meta"]
      },
      "ProbeEvaluation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "probeId": { "type": "string", "format": "uuid" },
          "attemptId": { "type": "string", "format": "uuid" },
          "attemptRevision": {
            "type": "integer",
            "format": "int32",
            "description": "إصدار محاولة، يعادل bigint في PostgreSQL لكنه مقيد هنا إلى Int32 آمن لواجهات JavaScript.",
            "minimum": 0,
            "maximum": 2147483647,
            "example": 4
          },
          "evaluation": {
            "type": "string",
            "enum": ["supported", "not_supported", "unclear", "unverified"]
          },
          "diagnosis": {
            "anyOf": [
              { "$ref": "#/components/schemas/DiagnosisCandidate" },
              { "type": "null" }
            ]
          },
          "feedbackAr": { "type": "string" },
          "nextAction": {
            "type": "string",
            "enum": ["hint", "remediation", "continue", "clarify"]
          }
        },
        "required": [
          "probeId",
          "attemptId",
          "attemptRevision",
