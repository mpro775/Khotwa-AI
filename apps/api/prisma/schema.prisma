  verification_runs     verification_runs[]
  skill_evidence        skill_evidence[]

  @@index([attempt_id, attempt_revision, finished_at(sort: Desc)], map: "reports_by_attempt_revision")
}

model misconception_catalog {
  id               String           @id @db.Uuid
  release_id       String           @db.Uuid
  error_code       String           @db.VarChar(32)
  skill_id         String           @db.Uuid
  catalog_version  String           @db.VarChar(80)
  enabled          Boolean          @default(false)
  is_synthetic     Boolean          @default(false)
  review_status    String
  reviewed_by_role String?
  reviewed_at      DateTime?        @db.Timestamptz(6)
  content_releases content_releases @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skills           skills           @relation(fields: [skill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([release_id, error_code])
}

model diagnostic_templates {
  id                String              @id @db.Uuid
  release_id        String              @db.Uuid
  family            String              @db.VarChar(80)
  template_version  String              @db.VarChar(80)
  question_ar       String
  options_json      Json
  rules_json        Json
  enabled           Boolean             @default(false)
  is_synthetic      Boolean             @default(false)
  review_status     String
  reviewed_by_role  String?
  reviewed_at       DateTime?           @db.Timestamptz(6)
  content_releases  content_releases    @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  diagnoses         diagnoses[]
  diagnostic_probes diagnostic_probes[]

  @@unique([release_id, family, template_version])
}

model diagnoses {
  id                       String                @id @db.Uuid
  attempt_id               String                @db.Uuid
  verification_result_id   String                @db.Uuid
  attempt_revision         BigInt
  release_id               String                @db.Uuid
  template_id              String?               @db.Uuid
  diagnosis_policy_version String                @db.VarChar(80)
  candidate_json           Json
  basis_json               Json
  created_at               DateTime              @default(now()) @db.Timestamptz(6)
