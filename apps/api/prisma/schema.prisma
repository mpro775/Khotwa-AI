generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
  engineType      = "client"
}

// DEV-021…025. PostgreSQL owns the supplemental FK/check constraints in 0011.
model users {
  id                String   @id @db.Uuid
  email_normalized  String   @unique @db.VarChar(254)
  email_verified_at DateTime @db.Timestamptz(6)
  role              String
  status            String
  is_internal       Boolean  @default(false)
  learning_guest_id String?  @unique @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
}

model auth_sessions {
  id           String    @id @db.Uuid
  user_id      String    @db.Uuid
  token_digest Bytes     @unique
  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, expires_at], map: "auth_sessions_user_expiry", where: raw("revoked_at IS NULL"))
}

model email_login_challenges {
  id             String    @id @db.Uuid
  email_digest   Bytes
  code_digest    Bytes
  expires_at     DateTime  @db.Timestamptz(6)
  attempts       Int       @default(0)
  consumed_at    DateTime? @db.Timestamptz(6)
  delivery_state String
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([email_digest, created_at], map: "login_challenge_email")
  @@index([expires_at], map: "login_challenge_expiry")
}

model account_request_keys {
  id           String   @id @db.Uuid
  scope_digest Bytes
  operation    String
  key_digest   Bytes
  fingerprint  Bytes
  response     Json
  expires_at   DateTime @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([scope_digest, operation, key_digest])
}

model guest_account_claims {
  id                     String   @id @db.Uuid
  guest_session_id       String   @unique @db.Uuid
  user_id                String   @db.Uuid
  target_guest_id        String   @db.Uuid
  learning_session_count Int
  consent_version        String
  created_at             DateTime @default(now()) @db.Timestamptz(6)
}

model account_deletion_requests {
  id           String    @id @db.Uuid
  user_id      String    @unique @db.Uuid
  status       String
  requested_at DateTime  @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
}

model beta_feedback {
  id               String   @id @db.Uuid
  owner_key        String
  kind             String
  message_redacted String
  request_id       String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_key, created_at], map: "beta_feedback_owner_created")
}

model beta_ai_reservations {
  id                  String   @id @db.Uuid
  owner_key           String
  maximum_tokens      Int
  maximum_cost_micros BigInt
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  authorization_id    String?  @db.VarChar(160)
  model               String?  @db.VarChar(120)
  deadline_at         DateTime? @db.Timestamptz(6)
  finished_at         DateTime? @db.Timestamptz(6)

  @@index([owner_key, created_at], map: "beta_ai_reservations_owner_created")
  @@index([authorization_id, created_at], map: "beta_ai_authorization_calls")
}

model account_learning_consents {
  user_id        String   @id @db.Uuid
  enabled        Boolean  @default(false)
  policy_version String   @db.VarChar(80)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
}

model account_ai_consents {
  user_id        String   @id @db.Uuid
  enabled        Boolean  @default(false)
  policy_version String   @db.VarChar(80)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
}

model external_ai_runtime {
  authorization_id String   @id @db.VarChar(160)
  quota_stopped    Boolean  @default(false)
  reserved_calls   Int      @default(0)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attempts {
  id                            String                 @id @db.Uuid
  learning_session_id           String                 @db.Uuid
  problem_revision_id           String                 @db.Uuid
  attempt_kind                  String
  revision                      BigInt                 @default(0)
  status                        String
  completion_verdict            String?
  opened_at                     DateTime               @default(now()) @db.Timestamptz(6)
  closed_at                     DateTime?              @db.Timestamptz(6)
  updated_at                    DateTime               @default(now()) @db.Timestamptz(6)
  notation_profile              String                 @db.VarChar(80)
  learning_sessions             learning_sessions      @relation(fields: [learning_session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  problem_revisions             problem_revisions      @relation(fields: [problem_revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  step_slots                    step_slots[]
  verification_runs             verification_runs[]
  verification_reports          verification_reports[]
  diagnoses                     diagnoses[]
  highest_hint_level_seen       Int                    @default(0) @db.SmallInt
  independent_evidence_eligible Boolean                @default(true)
  full_solution_seen            Boolean                @default(false)
  assistance_revision           Int                    @default(0)
  hint_requests                 hint_requests[]
  tutoring_events               tutoring_events[]
  episodes                      learning_episodes[]
  assignment                    learning_assignments?
  skill_evidence                skill_evidence[]

  @@index([learning_session_id, id], map: "attempt_learning")
}

model audit_events {
  id               String   @id @db.Uuid
  correlation_id   String   @db.Uuid
  entity_kind      String   @db.VarChar(80)
  entity_id        String?  @db.Uuid
  event_code       String   @db.VarChar(80)
  limited_metadata Json     @default("{}")
  created_at       DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model content_releases {
  id                     String                   @id @db.Uuid
  release_code           String                   @unique @db.VarChar(80)
  subject_code           String                   @db.VarChar(40)
  notation_profile       String                   @db.VarChar(80)
  curriculum_label_ar    String
  status                 String
  reviewed_by_role       String?
  reviewed_at            DateTime?                @db.Timestamptz(6)
  published_at           DateTime?                @db.Timestamptz(6)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  learning_sessions      learning_sessions[]
  problem_revisions      problem_revisions[]
  skills                 skills[]
  misconception_catalog  misconception_catalog[]
  diagnostic_templates   diagnostic_templates[]
  diagnoses              diagnoses[]
  intervention_templates intervention_templates[]
  content_pairings       content_pairings[]
  learning_episodes      learning_episodes[]
  skill_evidence         skill_evidence[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model guest_sessions {
  id                  String                @id @db.Uuid
  token_digest        Bytes                 @unique
  status              String
  expires_at          DateTime              @db.Timestamptz(6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  last_seen_at        DateTime              @default(now()) @db.Timestamptz(6)
  revoked_at          DateTime?             @db.Timestamptz(6)
  consent_snapshot    Json?
  idempotency_records idempotency_records[]
  learning_sessions   learning_sessions[]
  content_exposures   content_exposures[]

  @@index([expires_at], map: "guest_expiry")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model idempotency_records {
  id                   String                 @id @db.Uuid
  guest_session_id     String                 @db.Uuid
  operation            String                 @db.VarChar(200)
  key_digest           Bytes
  fingerprint          Bytes
  state                String
  response_code        Int?                   @db.SmallInt
  response_cache       Json?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  expires_at           DateTime               @db.Timestamptz(6)
  guest_sessions       guest_sessions         @relation(fields: [guest_session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verification_reports verification_reports[]
  hint_requests        hint_requests[]

  @@unique([guest_session_id, operation, key_digest])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model learning_sessions {
  id                     String           @id @db.Uuid
  guest_session_id       String           @db.Uuid
  release_id             String           @db.Uuid
  status                 String
  started_at             DateTime         @default(now()) @db.Timestamptz(6)
  ended_at               DateTime?        @db.Timestamptz(6)
  is_synthetic           Boolean          @default(false)
  session_policy_version String           @db.VarChar(80)
  attempts               attempts[]
  guest_sessions         guest_sessions   @relation(fields: [guest_session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content_releases       content_releases @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skill_evidence         skill_evidence[]

  @@unique([id, release_id])
  @@index([guest_session_id, id], map: "learning_owner")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model parse_results {
  id                       String        @id @db.Uuid
  step_version_id          String        @db.Uuid
  engine_version           String        @db.VarChar(80)
  notation_profile_version String        @db.VarChar(80)
  parse_status             String
  normalized_text          String?
  display_text             String?
  ast                      Json?
  reason_code              String?
  issue_span               Json?
  created_at               DateTime      @default(now()) @db.Timestamptz(6)
  step_versions            step_versions @relation(fields: [step_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([step_version_id, engine_version, notation_profile_version, created_at(sort: Desc)], map: "parses_by_version")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model problem_revisions {
  id                     String                   @id @db.Uuid
  problem_id             String                   @db.Uuid
  version_number         Int
  release_id             String                   @db.Uuid
  item_kind              String
  statement_ar           String
  original_equation_raw  String?
  original_equation_ast  Json?
  answer_spec            Json
  difficulty_band        Int                      @db.SmallInt
  notation_profile       String                   @db.VarChar(80)
  review_status          String
  reviewed_at            DateTime?                @db.Timestamptz(6)
  published_at           DateTime?                @db.Timestamptz(6)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  content_hash           String
  attempts               attempts[]
  problems               problems                 @relation(fields: [problem_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content_releases       content_releases         @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  problem_skills         problem_skills?
  verification_runs      verification_runs[]
  verification_reports   verification_reports[]
  intervention_templates intervention_templates[]
  hint_requests          hint_requests[]
  tutoring_events        tutoring_events[]
  learning_family        String?                  @db.VarChar(100)
  pair_roots             content_pairings[]       @relation("pair_root")
  pair_remediations      content_pairings[]       @relation("pair_remediation")
  pair_transfers         content_pairings[]       @relation("pair_transfer")
  learning_assignments   learning_assignments[]
  content_exposures      content_exposures[]
  skill_evidence         skill_evidence[]

  @@unique([id, release_id])
  @@unique([problem_id, version_number])
