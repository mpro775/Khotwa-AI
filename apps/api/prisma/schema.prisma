/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model problem_skills {
  problem_revision_id String            @unique(map: "one_primary_skill", where: raw("(coverage_kind = 'primary'::text)")) @db.Uuid
  skill_id            String            @db.Uuid
  coverage_kind       String
  problem_revisions   problem_revisions @relation(fields: [problem_revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skills              skills            @relation(fields: [skill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([problem_revision_id, skill_id])
}

model problems {
  id                String              @id @db.Uuid
  problem_code      String              @unique @db.VarChar(80)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  archived_at       DateTime?           @db.Timestamptz(6)
  problem_revisions problem_revisions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
