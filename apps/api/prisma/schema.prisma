model verification_reports {
  id                    String              @id @db.Uuid
  attempt_id            String              @db.Uuid
  idempotency_record_id String              @db.Uuid
  attempt_revision      BigInt
  problem_revision_id   String              @db.Uuid
  notation_profile      String              @db.VarChar(80)
  engine_version        String              @db.VarChar(80)
  scope                 String
  target_step_id        String?             @db.Uuid
  step_version_ids      String[]            @db.Uuid
  dispatch_status       String
  report_json           Json?
  final_result_json     Json?
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  deadline_at           DateTime            @db.Timestamptz(6)
  finished_at           DateTime?           @db.Timestamptz(6)
  attempts              attempts            @relation(fields: [attempt_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  idempotency_records   idempotency_records @relation(fields: [idempotency_record_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
