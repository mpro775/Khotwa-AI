# PH-08 synthetic review only; no external AI or gate approval.
PH08_API_ENABLED=false
PH08_MAX_REMEDIATION_ASSIGNMENTS=
PH08_MAX_TRANSFER_ASSIGNMENTS=

# PH-09 independent synthetic teacher artifact and current progress only.
PH09_API_ENABLED=false
