# Development only. Run npm run env:local; never commit generated values.
POSTGRES_PASSWORD=
INTERNAL_HEALTH_TOKEN=
MATH_INTERNAL_TOKEN=
# AI is intentionally disabled; no provider or learner data in PH-01.
AI_ENABLED=false
# PH-04: local rollout only; set true after migrations and HTTPS configuration.
PH04_API_ENABLED=false
PH05_API_ENABLED=false
PH05_VERIFY_TIMEOUT_MS=
# Synthetic test profile only; never claim human content review from this flag.
KHOTWA_SYNTHETIC_DATA=false
PUBLIC_APP_ORIGIN=
GUEST_DIGEST_KEY=
BOOTSTRAP_SIGNING_KEY=
CSRF_SIGNING_KEY=
GUEST_ISSUE_KEY=
IDEMPOTENCY_DIGEST_KEY=
CURSOR_SIGNING_KEY=
# Explicit experimental settings; final security/performance policy is pending.
PH04_BOOTSTRAP_TTL_SECONDS=
PH04_RATE_LIMIT_MAX=
PH04_RATE_LIMIT_WINDOW_SECONDS=
PH04_MATH_TIMEOUT_MS=

# PH06 is opt-in and restricted to synthetic review until Gate-1/content approval.
PH06_API_ENABLED=false

# PH-07 synthetic review only; external AI remains disabled by owner decision.
PH07_API_ENABLED=false
PH07_REQUEST_TIMEOUT_MS=
PH07_AI_TIMEOUT_MS=
PH07_MAX_INPUT_BYTES=
PH07_MAX_OUTPUT_TOKENS=
PH07_GUEST_CALLS=
PH07_GLOBAL_CALLS=
PH07_GUEST_COST_UNITS=
PH07_GLOBAL_COST_UNITS=
PH07_MAX_PARALLEL=

# PH-08 synthetic review only; Gemini requires explicit opt-in below; no gate approval.
PH08_API_ENABLED=false
PH08_MAX_REMEDIATION_ASSIGNMENTS=
PH08_MAX_TRANSFER_ASSIGNMENTS=

# PH-08 Gemini review only. Enable AI_ENABLED explicitly; PH09 must be disabled.
# Inject GEMINI_API_KEY into the server process secret environment, never Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
PH08_GEMINI_TIMEOUT_MS=8000
GEMINI_ROUND_CALL_LIMIT=10
# Actual remaining daily requests, or explicit 'unlimited' if confirmed by owner.
# Valid-until is the quota snapshot/round expiry (ISO); unknown/expired fails closed.
# No automatic reset or retry. Other uses of the same project share its quota.
GEMINI_DAILY_REMAINING=
GEMINI_QUOTA_VALID_UNTIL=
# Absolute path on persistent private storage; reuse the SAME ledger on restart.
GEMINI_QUOTA_LEDGER_PATH=

# PH-09 independent synthetic teacher artifact and current progress only.
PH09_API_ENABLED=false
