# Development only. Run npm run env:local; never commit generated values.
POSTGRES_PASSWORD=
INTERNAL_HEALTH_TOKEN=
MATH_INTERNAL_TOKEN=
# AI is intentionally disabled; no provider or learner data in PH-01.
AI_ENABLED=false
# PH-04: local rollout only; set true after migrations and HTTPS configuration.
PH04_API_ENABLED=false
PH05_API_ENABLED=false
PH05_VERIFY_TIMEOUT_MS=
# Synthetic test profile only; never claim human content review from this flag.
KHOTWA_SYNTHETIC_DATA=false
PUBLIC_APP_ORIGIN=
GUEST_DIGEST_KEY=
BOOTSTRAP_SIGNING_KEY=
CSRF_SIGNING_KEY=
GUEST_ISSUE_KEY=
IDEMPOTENCY_DIGEST_KEY=
CURSOR_SIGNING_KEY=
# Explicit experimental settings; final security/performance policy is pending.
PH04_BOOTSTRAP_TTL_SECONDS=
PH04_RATE_LIMIT_MAX=
PH04_RATE_LIMIT_WINDOW_SECONDS=
PH04_MATH_TIMEOUT_MS=

# PH06 is opt-in and restricted to synthetic review until Gate-1/content approval.
PH06_API_ENABLED=false

# PH-07 synthetic review only; external AI remains disabled by owner decision.
PH07_API_ENABLED=false
PH07_REQUEST_TIMEOUT_MS=
PH07_AI_TIMEOUT_MS=
PH07_MAX_INPUT_BYTES=
PH07_MAX_OUTPUT_TOKENS=
PH07_GUEST_CALLS=
PH07_GLOBAL_CALLS=
PH07_GUEST_COST_UNITS=
PH07_GLOBAL_COST_UNITS=
PH07_MAX_PARALLEL=

# PH-08 synthetic review only; Gemini requires explicit opt-in below; no gate approval.
PH08_API_ENABLED=false
PH08_MAX_REMEDIATION_ASSIGNMENTS=
PH08_MAX_TRANSFER_ASSIGNMENTS=

# PH-08 Gemini review only. Enable AI_ENABLED explicitly; PH09 must be disabled.
# Inject GEMINI_API_KEY into the server process secret environment, never Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# JSON supplied by the operator; no bundled rates or invoice claims.
# {"version":"reviewed-price-version","currency":"USD","models":{}}
# Each model maps to nonnegative integer inputMicrosPerMillion/outputMicrosPerMillion.
GEMINI_PRICING_JSON=
GEMINI_THINKING_LEVEL=minimal
PH08_GEMINI_GENERATIVE_ENABLED=false
# Offline review: default transport throws until a test injects a mock; no key used.
PH08_GEMINI_OFFLINE=false
# Future live round requires independent approval reference and explicit ceiling.
GEMINI_LIVE_AUTHORIZATION_ID=
PH08_GEMINI_TIMEOUT_MS=8000
GEMINI_ROUND_CALL_LIMIT=10
# Known positive remaining daily requests. Unknown/unlimited cannot enable live.
# Valid-until is the quota snapshot/round expiry (ISO); unknown/expired fails closed.
# No automatic reset or retry. Other uses of the same project share its quota.
GEMINI_DAILY_REMAINING=
GEMINI_QUOTA_VALID_UNTIL=
# Absolute path on persistent private storage; reuse the SAME ledger on restart.
GEMINI_QUOTA_LEDGER_PATH=

# PH-09 independent synthetic teacher artifact and current progress only.
PH09_API_ENABLED=false

# Fresh, explicit closed-Beta policies. No historical PH08 approval is reused.
REAL_LEARNING_ENABLED=false
REAL_LEARNING_POLICY_VERSION=real-learning-v1
REAL_LEARNING_APPROVAL_REFERENCE=
BETA_ENABLED=false
BETA_ACCESS_PAUSED=true
BETA_AI_ENABLED=false
BETA_GEMINI_ENABLED=false
BETA_GEMINI_AUTHORIZATION_ID=
BETA_GEMINI_AUTHORIZATION_EXPIRES_AT=
BETA_GEMINI_MODEL=
BETA_GEMINI_THINKING_LEVEL=minimal
BETA_GEMINI_KNOWN_DAILY_REMAINING=
BETA_GEMINI_DAILY_REQUEST_LIMIT=20
BETA_GEMINI_RPM=5
BETA_GEMINI_MAX_PARALLEL=1
BETA_GEMINI_TIMEOUT_MS=8000
# Set total_generation only after verifying the model caps all billable output
# (including thinking) via maxOutputTokens. Blank keeps this runtime disabled.
BETA_GEMINI_OUTPUT_CAP_POLICY=
BETA_GEMINI_MAX_BILLABLE_OUTPUT_TOKENS=256
BETA_AI_DAILY_COST_MICROS=0
BETA_AI_MONTHLY_COST_MICROS=0
BETA_AI_MAX_CALL_COST_MICROS=0
BETA_AI_USER_DAILY_CALLS=10
BETA_AI_USER_DAILY_TOKENS=64000
